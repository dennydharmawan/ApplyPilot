# ApplyPilot Environment Configuration
# Copy to the profile directory (.env) and fill in your values.

# LLM (default: Codex CLI on PATH)
# LLM_PROVIDER=codex
# LLM_MODEL=gpt-5.6-luna
# LLM_REASONING_EFFORT=high

# Fallbacks if Codex is not installed:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=

# Auto-Apply (optional)
# CAPSOLVER_API_KEY=

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
